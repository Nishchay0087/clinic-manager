# Use credentials from your MySQL provider; never commit a filled-in copy.
DB_URL=jdbc:mysql://YOUR_MYSQL_HOST:3306/clinic_manager?sslMode=VERIFY_IDENTITY&serverTimezone=Asia/Kolkata
DB_USERNAME=clinic_app
DB_PASSWORD=replace-me
DB_POOL_SIZE=4
APP_BASE_URL=https://YOUR_PROJECT.vercel.app/clinic-manager
CLINIC_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=true
DOCUMENT_STORAGE_MODE=mysql
SCHEDULER_ENABLED=false
# Configure an external scheduled HTTP request to /clinic-manager/internal/jobs.
# Supply Authorization: Bearer <CRON_SECRET>. Choose at least 32 random characters.
CRON_SECRET=replace-with-a-long-random-secret
PORT=8080
