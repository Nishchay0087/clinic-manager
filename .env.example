DB_URL=jdbc:mysql://localhost:3306/clinic_manager?serverTimezone=Asia/Kolkata
DB_USERNAME=clinic_app
DB_PASSWORD=replace-with-your-own-password
DOCUMENT_STORAGE_DIR=/absolute/path/outside/tomcat/medical-documents
APP_BASE_URL=http://localhost:8080/clinic-manager
CLINIC_TIMEZONE=Asia/Kolkata
COOKIE_SECURE=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
DOCUMENT_MAX_MB=10

# mysql for persistent cloud deployments; filesystem for the legacy local demo
DOCUMENT_STORAGE_MODE=mysql
DB_POOL_SIZE=4
SCHEDULER_ENABLED=true
# Set a 32+ character secret only if using the external jobs endpoint
CRON_SECRET=
