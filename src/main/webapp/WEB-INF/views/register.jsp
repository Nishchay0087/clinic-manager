<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create account · E-Healthcare</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><main class="auth-page"><aside class="auth-aside"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">+</span><span>e-healthcare<small>CLINIC MANAGER</small></span></a><div><span class="eyebrow">Your health, in good hands</span><h1>One account.<br>A healthier connection.</h1><p>Find your doctor, book your next visit, and access your medical documents from wherever you are.</p></div><small class="muted">Private records. Personal care. Peace of mind.</small></aside><section class="auth-content"><form class="auth-form" method="post" action="${pageContext.request.contextPath}/register"><h1>Create your account</h1><p class="subtitle">Your personal healthcare journey starts here.</p><c:if test="${not empty error}"><div class="error" role="alert"><c:out value="${error}"/></div></c:if><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><div class="field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" required maxlength="120" placeholder="Your full name"></div><div class="field"><label for="email">Email address</label><input type="email" id="email" name="email" autocomplete="username" required maxlength="254" placeholder="you@example.com"></div><div class="field"><label for="password">Password</label><input type="password" id="password" name="password" autocomplete="new-password" required minlength="12" maxlength="72" placeholder="Create a secure password"><small>Use 12–72 characters.</small></div><div class="field"><label for="confirmPassword">Confirm password</label><input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required minlength="12" maxlength="72" placeholder="Enter your password again"></div><button class="primary" type="submit">Create patient account →</button><div class="auth-foot">Already have an account? <a href="${pageContext.request.contextPath}/login">Sign in</a></div></form></section></main></body></html>
