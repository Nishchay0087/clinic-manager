<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign in · E-Healthcare</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body><main class="auth-page"><aside class="auth-aside"><a class="brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">+</span><span>e-healthcare<small>CLINIC MANAGER</small></span></a><div><span class="eyebrow">A little less admin. A lot more care.</span><h1>Better care starts with connection.</h1><p>A simpler way to manage appointments, stay on top of your health, and keep your medical records together.</p></div><small class="muted">Built around people. Designed for better care.</small></aside><section class="auth-content"><form class="auth-form" method="post" action="${pageContext.request.contextPath}/login"><h1>Welcome back</h1><p class="subtitle">Sign in to your healthcare workspace.</p><c:if test="${not empty error}"><div class="error" role="alert"><c:out value="${error}"/></div></c:if><input type="hidden" name="csrf" value="<c:out value='${csrf}'/>"><div class="field"><label for="email">Email address</label><input type="email" id="email" name="email" autocomplete="username" placeholder="you@example.com" required maxlength="254"></div><div class="field"><label for="password">Password</label><input type="password" id="password" name="password" autocomplete="current-password" required placeholder="Enter your password"></div><button type="submit" class="primary">Sign in to your account →</button><div class="auth-foot">New to E-Healthcare? <a href="${pageContext.request.contextPath}/register">Create a patient account</a></div></form></section></main></body></html>
